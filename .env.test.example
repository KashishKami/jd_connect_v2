# ==========================================
# JD Connect — Test Environment Config Template
# ==========================================

# Server Settings
NODE_ENV=test
PORT=4001

# Backend API Database (Postgres container - test database)
DATABASE_URL=postgresql://jduser:jdpassword@127.0.0.1:5432/jdconnect_test?schema=public

# JWT Authentication
JWT_SECRET=test-secret-jwt-key-min-32-chars-long-for-vitest
JWT_EXPIRATION=1h

# Zulip Integration & Admin Bot API (Mocked in integration tests)
ZULIP_BASE_URL=http://127.0.0.1:9991
ZULIP_BOT_EMAIL=jdconnect-bot@company.com
ZULIP_BOT_API_KEY=zulip_bot_api_key_test
ZULIP_ATTENDANCE_STREAM=attendance

# Unified Portal & CORS
# The old attendance-app and hr-dashboard have been merged into the unified portal (portal/).
PORTAL_URL=http://127.0.0.1:3200
BACKEND_URL=http://127.0.0.1:4001
ALLOWED_CORS_ORIGINS=http://127.0.0.1:3200,http://localhost:3200,http://127.0.0.1:9991

# Zulip Bot — link posted in the daily attendance message.
# The bot reads CLOCK_APP_URL (not PORTAL_URL) — this is the URL employees click to open the portal.
CLOCK_APP_URL=http://localhost:3200
