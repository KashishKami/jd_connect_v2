# ==========================================
# JD Connect — Test Environment Config Template
# ==========================================

# Server Settings
NODE_ENV=test
PORT=4001

# Backend API Database (Postgres container - test database)
DATABASE_URL=postgresql://jduser:jdpassword@127.0.0.1:5432/jdconnect_test?schema=public

# JWT Authentication
JWT_SECRET=test-secret-jwt-key-min-32-chars-long-for-vitest
JWT_EXPIRATION=1h

# Rocket.Chat Integration & Admin API (Mocked in integration tests)
ROCKETCHAT_URL=http://127.0.0.1:3100
ROCKETCHAT_ADMIN_USER=test_admin
ROCKETCHAT_ADMIN_PASSWORD=test_password

# Frontend HR Dashboard
HR_DASHBOARD_URL=http://127.0.0.1:3000
ALLOWED_CORS_ORIGINS=http://127.0.0.1:3000
