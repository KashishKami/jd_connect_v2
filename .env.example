# ==========================================
# JD Connect — Development Environment Config
# ==========================================

# Server Settings
NODE_ENV=development
PORT=4000

# Backend API Database (Postgres container - dev database)
DATABASE_URL=postgresql://jduser:jdpassword@127.0.0.1:5432/jdconnect?schema=public

# JWT Authentication
JWT_SECRET=super-secret-dev-jwt-key-min-32-chars-long
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Zulip Integration & Admin Bot API
ZULIP_BASE_URL=https://127.0.0.1:9991
ZULIP_BOT_EMAIL=jdconnect-bot@company.com
ZULIP_BOT_API_KEY=zulip_bot_api_key_here
ZULIP_ATTENDANCE_STREAM=attendance

# Frontend Apps & CORS
HR_DASHBOARD_URL=http://127.0.0.1:3200
CLOCK_APP_URL=http://127.0.0.1:3300
BACKEND_URL=http://127.0.0.1:4000
ALLOWED_CORS_ORIGINS=http://127.0.0.1:3200,http://127.0.0.1:3300,http://127.0.0.1:9991,http://localhost:3300,http://localhost:3200

