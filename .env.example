# ==========================================
# JD Connect — Development Environment Config
# ==========================================

# Server Settings
NODE_ENV=development
PORT=4000

# Backend API Database (Postgres container - dev database)
DATABASE_URL=postgresql://jduser:jdpassword@127.0.0.1:5432/jdconnect?schema=public

# JWT Authentication
JWT_SECRET=super-secret-dev-jwt-key-min-32-chars-long
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Rocket.Chat Integration & Admin API
ROCKETCHAT_URL=http://127.0.0.1:3100
ROCKETCHAT_ADMIN_USER=admin
ROCKETCHAT_ADMIN_PASSWORD=adminpassword
ROCKETCHAT_ADMIN_TOKEN=rc_admin_token_here
ROCKETCHAT_ADMIN_ID=rc_admin_id_here

# Frontend HR Dashboard
HR_DASHBOARD_URL=http://127.0.0.1:3000
ALLOWED_CORS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3100
